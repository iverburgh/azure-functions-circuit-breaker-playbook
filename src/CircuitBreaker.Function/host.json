{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request;Exception"
      }
    },
    "logLevel": {
      "default": "Information",
      "Azure.Core": "Warning",
      "DurableTask.Core": "Warning",
      "DurableTask.AzureStorage": "Warning"
    }
  },
  "extensions": {
    "durableTask": {
      "hubName": "%TaskHubName%"
    }
  }
}
